# Include inside a NEW HTTPS server {} for the knowledge base hostname.
# Keep existing client virtual hosts and their locations unchanged.
location / {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $knowledgebase_upstream knowledgebase-app:8080;
    proxy_pass http://$knowledgebase_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    client_max_body_size 12m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
}
